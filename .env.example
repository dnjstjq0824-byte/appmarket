POSTGRES_PASSWORD=replace-with-random-local-password
REDIS_PASSWORD=replace-with-random-local-password
MINIO_ROOT_USER=replace-with-random-local-user
MINIO_ROOT_PASSWORD=replace-with-random-local-password
GRAFANA_ADMIN_USER=replace-with-random-local-user
GRAFANA_ADMIN_PASSWORD=replace-with-random-local-password
ALLOWED_ORIGIN=http://localhost:3000
# Set only to the CIDRs of reverse proxies you operate. Leave empty for direct clients.
TRUSTED_PROXY_CIDRS=
# --- API secrets (required, 32+ random bytes each, never commit real values) ---
IAM_HMAC_SECRET=replace-with-random-32-plus-chars
DISTRIBUTION_TOKEN_SECRET=replace-with-random-32-plus-chars
PG_WEBHOOK_SECRET=replace-with-random-32-plus-chars
# --- API settings ---
JWT_ISSUER=https://auth.appmarket.local
# RS256 private key (PKCS#8 PEM, single line with \n or file-mounted). Required in production.
JWT_PRIVATE_KEY_PEM=
CDN_DOMAIN=cdn.appmarket.local
PUBLIC_BASE_URL=https://appmarket.bookingnetwork.internal
PG_PROVIDER=toss
TOSS_SECRET_KEY=
PORTONE_API_KEY=
PORTONE_STORE_ID=
PG_IS_LIVE=false
SENTRY_DSN=
APP_ENV=development
# --- Social login (empty value = provider disabled) ---
OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/v1/auth/oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
